# Copy to `.env.local` (npm) or `.env` (Docker) as needed.

# Public URL for links in the UI and emails (no trailing slash)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Local SQLite file (default: ./data/app.db). Ignored when using Turso below.
# DATABASE_PATH=/absolute/path/to/app.db

# Turso (optional — omit both to use local file above)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=...

# Resend (optional — emails for join confirmation + draw ready)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="NYE tradition <onboarding@resend.dev>"
